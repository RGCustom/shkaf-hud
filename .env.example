# Скопируй в .env и заполни своими значениями. .env в .gitignore - в репозиторий не попадёт.

SERIAL_DEVICE_PATH=/dev/serial/by-id/CHANGE_ME
ARRAY_PATH=/mnt/user
BIGCACHE_PATH=/mnt/bigcache

TAUTULLI_URL=http://127.0.0.1:8181
TAUTULLI_API_KEY=

QBT_URL=http://127.0.0.1:8080
QBT_API_KEY=

NET_IFACE=br0
NET_MAX_MBPS=300

DISK_DEVICES=

ARRAY_REFRESH_SECONDS=60
CACHE_REFRESH_SECONDS=60
CPU_TEMP_MAX_C=90
LIBRARY_REFRESH_SECONDS=300

RECENT_REFRESH_SECONDS=120
RECENT_MAX_AGE_DAYS=5
RECENT_COUNT=5

FULL_RESYNC_SECONDS=30
POLL_INTERVAL=1.0
WEB_PORT=8189

BAUD=115200
