# Скопируй в .env и заполни своими значениями. .env в .gitignore - в репозиторий не попадёт.

SERIAL_DEVICE_PATH=/dev/serial/by-id/CHANGE_ME
ARRAY_PATH=/mnt/user

TAUTULLI_URL=http://127.0.0.1:8181
TAUTULLI_API_KEY=

NET_IFACE=eth0
NET_MAX_MBPS=500

DISK_DEVICES=

ARRAY_REFRESH_SECONDS=60
LIBRARY_REFRESH_SECONDS=300
SCREEN_ROTATE_SECONDS=4
POLL_INTERVAL=1.0

BAUD=115200
